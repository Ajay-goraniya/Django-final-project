# Polymarket v12.2 - copy to deploy.env, fill in, then: chmod 600 deploy.env
# Never commit this file. The engine reads these from the environment only.

# ---- Polymarket credentials (live mode only) --------------------------------
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# ---- Binance endpoints -------------------------------------------------------
# Comma-separated, tried in order, first reachable wins. The defaults below are
# what actually resolved from a test host: every api.binance.com mirror answered
# HTTP 451 while data-api.binance.vision served the identical /api/v3 payloads.
# Check yours with: python3 -m poly_selftest --feeds
BINANCE_REST_HOSTS=https://data-api.binance.vision,https://api.binance.com
BINANCE_WS_SPOT=wss://data-stream.binance.vision/ws/btcusdt@aggTrade,wss://stream.binance.com:9443/ws/btcusdt@aggTrade
BINANCE_WS_PERP=wss://fstream.binance.com/ws/btcusdt@trade
BINANCE_WS_DEPTH=wss://fstream.binance.com/ws/btcusdt@depth20@100ms
BINANCE_WS_CHART=wss://data-stream.binance.vision/ws/btcusdt@kline_5m

# ---- Feed staleness limits ---------------------------------------------------
# arrival = seconds since any message (socket liveness)
# lag     = seconds between a message's own event time and our receipt (freshness)
# A stream must pass BOTH to be usable. Raise the lag limit only if your host is
# genuinely far from Binance and you have measured the difference.
# Defaults come from a 100s measurement of real gaps: spot and perp are event
# driven and were observed gapping up to 2.6s with nobody trading, while depth is
# periodic at 100ms and never exceeded 0.52s. One flat 2s limit (v12.1) is below
# the observed maximum on two of the three, which makes a healthy feed read stale.
FEED_MAX_ARRIVAL_SPOT_S=6.0
FEED_MAX_ARRIVAL_PERP_S=6.0
FEED_MAX_ARRIVAL_DEPTH_S=2.0
FEED_MAX_ARRIVAL_VENUE_S=5.0
FEED_MAX_EVENT_LAG_S=2.5
FEED_STALL_RECONNECT_S=8.0
