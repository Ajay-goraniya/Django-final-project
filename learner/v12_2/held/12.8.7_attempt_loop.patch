--- b/learner/v12_2/test_polymarket.py
+++ a/learner/v12_2/test_polymarket.py
@@ -717,3 +717,75 @@ class PnLConditionsNeverHalt(unittest.TestCase):
         sites=[l for l in src.splitlines() if "set('halt'" in l]
